  "cards": [
    {
      "dot": "cyan",
      "title": "Trust ladder",
      "items": [
        "Working tree = proposal; your commit = ratified truth for everything in this folder",
        "The agent shows changes before commit/push and executes only after user approval",
        "Rules that protect you (honesty, pushback, approval) change only at a ratifying commit"
      ]
    },
    {
      "dot": "emerald",
      "title": "Memory tiers",
      "items": [
        "Rules frame · principles judge · skills execute · notes know · episodes remember",
        "Always loaded: AGENTS.md + kb/INDEX.md — line-budgeted, because loading costs context",
        "Every note claim carries src · method (human/web/model/derived) · verified · conf",
        "Model-generated claims are quarantined: listed, never asserted, verified by the ritual"
      ]
    },
    {
      "dot": "amber",
      "title": "Loops",
      "items": [
        "Session: one-line boot → work → one log block (automatic) → your commit",
        "Consolidate (on your word, every few days): distill · verify · bridge · Brief",
        "Plan: 'what should I do next?' answers from YOUR approved items; suggestions only when none remain",
        "Learning: what worked → candidate principle → you promote → loads; the same integration twice → a skill draft → your commit"
      ]
    },
    {
      "dot": "violet",
      "title": "Your projects",
      "items": [
        "Work stays where it lives; workspace/<project>/PROJECT.md where: lines point at those folders",
        "Each line echoed and assented once = standing permission (read-only unless you say rw)",
        "One live session per scope; end is the baton between agents and windows"
      ]
    }
  ]
